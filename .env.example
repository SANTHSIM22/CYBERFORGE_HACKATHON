# Local development only. Copy to .env (git-ignored). Never reuse these values anywhere real.
COMPOSE_PROFILES=demo

# Live-demo endpoints (add/cancel order, compare with direct SQL). Off unless true.
DEMO_MODE=true

POSTGRES_SUPERUSER_PASSWORD=local-superuser-pw
TP_OWNER_PASSWORD=local-owner-pw
TP_INGEST_PASSWORD=local-ingest-pw
TP_API_PASSWORD=local-api-pw
TP_PROVISIONER_PASSWORD=local-provisioner-pw
TP_REPLICATOR_PASSWORD=local-replicator-pw
TP_DEMO_PASSWORD=local-demo-pw
TP_APP_PASSWORD=local-app-pw
CLICKHOUSE_ADMIN_PASSWORD=local-ch-admin-pw
TP_CH_INGEST_PASSWORD=local-ch-ingest-pw
TP_CH_API_PASSWORD=local-ch-api-pw
TP_CH_MONITOR_PASSWORD=local-ch-monitor-pw

# Signs dev identity tokens (tenant:<slug> / operator). Min 16 chars.
AUTH_SECRET=local-dev-only-auth-secret-0123456789

# Default fleet seeded by the bootstrap service on first start.
SEED_TENANTS=3
SEED_ROWS=60000

WEB_PORT=8088
API_PORT=8080

MAX_CONCURRENT_SNAPSHOTS=2
INGEST_FLUSH_INTERVAL=1s
