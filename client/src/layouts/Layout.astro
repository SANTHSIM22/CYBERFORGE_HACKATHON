---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import type { IconName } from '../lib/icons';
interface Props {
  title: string;
  active: 'dashboard' | 'monitor';
}
const { title, active } = Astro.props;
type NavItem = { href: string; label: string; key?: Props['active']; icon: IconName };
const sections: { label: string; items: NavItem[] }[] = [
  { label: 'Analytics', items: [{ href: '/', label: 'Dashboard', key: 'dashboard', icon: 'layout-dashboard' }] },
  {
    label: 'Operations',
    items: [
      { href: '/monitor', label: 'Pipeline monitor', key: 'monitor', icon: 'activity' },
      { href: '/monitor#bench', label: 'Benchmarks', icon: 'gauge' },
    ],
  },
];
const crumbs = { dashboard: ['Analytics', 'Store dashboard'], monitor: ['Operations', 'Pipeline monitor'] }[active];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="TenantPulse: fast, fresh, tenant-isolated commerce analytics" />
    <meta name="theme-color" content="#062018" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      try {
        const t = localStorage.getItem('tp-theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body class="min-h-screen font-sans antialiased">
    <div class="app">
      <aside class="side hidden lg:flex" aria-label="Sidebar">
        <a href="/" class="brand px-2.5 py-1">
          <svg width="28" height="28" viewBox="0 0 28 28" aria-hidden="true">
            <rect width="28" height="28" rx="8" fill="#04DB7F"></rect>
            <path d="M5.5 15h3.5l2.5-6 4 11 2.5-6h4.5" fill="none" stroke="#062018" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <span>Tenant<span class="brand-accent">Pulse</span></span>
        </a>
        {sections.map((s) => (
          <>
            <div class="side-label">{s.label}</div>
            <nav class="flex flex-col gap-0.5" aria-label={s.label}>
              {s.items.map((n) => (
                <a href={n.href} class="side-link" aria-current={n.key === active ? 'page' : undefined}>
                  <Icon name={n.icon} size={17} />
                  {n.label}
                </a>
              ))}
            </nav>
          </>
        ))}
        <div class="mt-auto">
          <div class="side-card">
            <div class="flex items-center gap-2 text-[12.5px] font-medium">
              <Icon name="database" size={14} class="brand-accent" />
              Aggregation layer
            </div>
            <div class="mt-2.5 space-y-1.5 text-[11.5px]" style="color: var(--side-muted)">
              <div class="flex items-center gap-2"><Icon name="server" size={13} />Postgres per store</div>
              <div class="flex items-center gap-2"><Icon name="zap" size={13} />Logical replication</div>
              <div class="flex items-center gap-2"><Icon name="layers" size={13} />ClickHouse + cache</div>
            </div>
          </div>
          <div class="mt-3 px-2.5 font-mono text-[10px] tracking-[0.14em] uppercase" style="color: var(--side-muted)">Tenant isolated · v1</div>
        </div>
      </aside>

      <div class="flex min-w-0 flex-col">
        <header class="topbar">
          <div class="flex h-14 items-center gap-3 px-4 sm:px-6">
            <a href="/" class="brand lg:hidden" aria-label="TenantPulse home">
              <svg width="26" height="26" viewBox="0 0 28 28" aria-hidden="true">
                <rect width="28" height="28" rx="8" fill="#04DB7F"></rect>
                <path d="M5.5 15h3.5l2.5-6 4 11 2.5-6h4.5" fill="none" stroke="#062018" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </a>
            <nav class="crumb" aria-label="Breadcrumb">
              <span class="hidden sm:inline">{crumbs[0]}</span>
              <Icon name="chevron-right" size={14} class="hidden sm:block" />
              <b class="truncate">{crumbs[1]}</b>
            </nav>
            <div class="ml-auto flex min-w-0 items-center gap-2">
              <slot name="header-right" />
              <button id="theme" class="btn btn-icon" type="button" title="Switch light / dark theme" aria-label="Switch theme">
                <Icon name="moon" size={16} class="theme-moon" />
                <Icon name="sun" size={16} class="theme-sun" />
              </button>
            </div>
          </div>
          <nav class="flex flex-wrap gap-x-1 px-3 lg:hidden" aria-label="Main">
            {sections.flatMap((s) => s.items).map((n) => (
              <a href={n.href} class="mtab" aria-current={n.key === active ? 'page' : undefined}>
                <Icon name={n.icon} size={15} />
                {n.label.replace('Pipeline monitor', 'Monitor')}
              </a>
            ))}
          </nav>
        </header>
        <main class="mx-auto w-full max-w-[1400px] px-4 pt-6 pb-14 sm:px-6">
          <slot />
        </main>
      </div>
    </div>
    <div class="toasts" id="toasts" aria-live="polite"></div>
    <script>
      document.getElementById('theme')?.addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try {
          localStorage.setItem('tp-theme', root.dataset.theme);
        } catch {}
        window.dispatchEvent(new Event('tp-theme'));
      });
    </script>
  </body>
</html>
