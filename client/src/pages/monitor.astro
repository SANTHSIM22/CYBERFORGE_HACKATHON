---
import Layout from '../layouts/Layout.astro';
import Info from '../components/Info.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../lib/icons';
const tiles: { id: string; label: string; icon: IconName; tip: string }[] = [
  { id: 'p50', label: 'Query p50', icon: 'timer', tip: 'Half of all dashboard API reads in the last 60 s were answered faster than this (server time). Benchmark reads that deliberately skip the cache (stress test ClickHouse-only phase, Compare button) are counted separately.' },
  { id: 'p95', label: 'Query p95', icon: 'gauge', tip: '95% of dashboard API reads in the last 60 s were faster than this. Target: under 200 ms.' },
  { id: 'p99', label: 'Query p99', icon: 'clock', tip: '99% of reads were faster than this: the slow tail, usually reads that had to be computed in ClickHouse.' },
  { id: 'hit', label: 'Cache hit rate', icon: 'layers', tip: 'Share of reads answered from the in-memory cache. Each entry remembers the store data version it was computed at. When new data arrives, a read may get the previous answer (at most 5 s old) while the new one is computed in the background, so new data never sends every reader to ClickHouse at once. The dashboard auto-refresh always waits for the new version.' },
  { id: 'eps', label: 'Events / sec', icon: 'zap', tip: 'Row changes (inserts, updates, deletes) written into ClickHouse per second by the ingesters.' },
  { id: 'lag', label: 'Worker lag', icon: 'hourglass', tip: 'Time from a change committing in a store database to being queryable in ClickHouse, for the newest change.' },
];
// One row of charts per read path, coloured like the stress-test bars below.
// Direct and ClickHouse-only traffic comes from the stress test (or Compare).
const paths: { key: string; title: string; sub: string; color: string; cached: boolean }[] = [
  { key: 'direct', title: 'Direct: primary DB', sub: 'api-direct · every read runs on the store’s Postgres', color: '--series-2', cached: false },
  { key: 'clickhouse', title: 'ClickHouse only (cache bypassed)', sub: 'api · benchmark reads that skip cache and views', color: '--series-3', cached: false },
  { key: 'aggregation', title: 'Aggregation layer (ClickHouse + cache)', sub: 'api · normal dashboard reads', color: '--series-1', cached: true },
];
// PRD targets and the measured results (docs/RESULTS.md, 10M records, 100 stores).
const scorecard: { measure: string; how: string; good: string; great: string; result: string; verdict: string; met: boolean }[] = [
  { measure: 'Query speed', how: 'Time for each dashboard query at 10M records', good: 'Under 1 second', great: 'Under 200 ms',
    result: '≤ 77 ms p95 per query, cold in ClickHouse (all 9 queries); p99 84 ms through the API at 1,297 req/s, 0 errors', verdict: 'Great', met: true },
  { measure: 'Freshness', how: 'Time from adding an order to seeing it in the numbers', good: 'Under 5 minutes', great: 'Under 30 seconds',
    result: '1.8 s p95 (30 orders)', verdict: 'Great', met: true },
  { measure: 'Database safety', how: 'Normal app query time, with and without dashboard load', good: 'Less than 25% slower', great: 'Less than 10% slower',
    result: 'Store p95 355 ms with 100 dashboards on this layer vs 375 ms with no dashboards and the pipeline off: 5% faster, not slower (300 tx/s write storm). 0 dashboard queries reach the store databases', verdict: 'Great', met: true },
  { measure: 'Correctness', how: 'Compare your numbers with a direct database query', good: 'Matches on most queries', great: 'Matches on all queries',
    result: '8,724 / 8,724 checks match exactly: 100 stores (every widget, top N pages) and 10 org dashboards in 3 timezones', verdict: 'Great', met: true },
  { measure: 'Growth', how: 'Query speed at 1M vs 10M records', good: 'Less than 5× slower', great: 'Less than 2× slower',
    result: '1.11–1.86× slower (p50, all 9 queries)', verdict: 'Great', met: true },
];
const charts: { id: string; title: string; icon: IconName; tip: (p: (typeof paths)[number]) => string }[] = [
  { id: 'rps', title: 'Requests per second', icon: 'activity', tip: (p) => `${p.title}: API reads per second over the last 60 seconds.` },
  { id: 'p95', title: 'Query time p95', icon: 'gauge', tip: (p) => `${p.title}: per-second 95th-percentile server time of reads.` },
  { id: 'hit', title: 'Cache hit rate', icon: 'layers', tip: (p) => p.cached ? 'Per-second share of reads served from the cache.' : 'This path has no cache, so the hit rate stays at 0%.' },
];
---
<Layout title="TenantPulse · Monitor" active="monitor">
  <div slot="header-right" id="mon-state" class="chip"><span class="chip-dot" style="background: var(--ink-muted)"></span><span>Connecting…</span></div>

  <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
    <div>
      <div class="eyebrow mb-1">Operations</div>
      <h1 class="page-title">Pipeline monitor</h1>
      <p class="muted mt-0.5 text-[13px]">Live API latency, cache efficiency, ingestion throughput and per-store lag over the last 60 seconds</p>
    </div>
    <span class="muted inline-flex items-center gap-1.5 text-xs"><Icon name="clock" size={13} /><span id="updated" class="tabnum"></span></span>
  </div>

  <section class="grid grid-cols-2 gap-4 md:grid-cols-3 2xl:grid-cols-6" aria-label="Key figures">
    {tiles.map((t) => (
      <div class="card min-w-0 px-4 py-4">
        <div class="flex min-w-0 items-center gap-2">
          <span class="icon-tile sm"><Icon name={t.icon} size={14} /></span>
          <span class="eyebrow min-w-0 truncate">{t.label}</span><Info align="left" text={t.tip} />
        </div>
        <div id={`m-${t.id}`} class="skel mt-3 w-fit max-w-full min-w-16 truncate text-[22px] leading-8 font-semibold tracking-[-0.03em] tabnum sm:text-[26px]">—</div>
        <div id={`m-${t.id}-sub`} class="muted mt-1 min-h-4 truncate text-[11px]"></div>
      </div>
    ))}
  </section>

  {paths.map((p) => (
    <section class="mt-5" aria-label={p.title}>
      <div class="mb-2.5 flex flex-wrap items-center gap-x-2 gap-y-0.5">
        <span class="inline-block h-2.5 w-2.5 rounded-sm" style={`background: var(${p.color})`}></span>
        <h2 class="text-sm font-semibold">{p.title}</h2>
        <span class="muted text-xs">{p.sub}</span>
      </div>
      <div class="grid gap-4 lg:grid-cols-3">
        {charts.map((c) => (
          <div class="card min-w-0 p-5">
            <div class="mb-2 flex items-start gap-3">
              <span class="icon-tile" style={`color: var(${p.color}); background: color-mix(in srgb, var(${p.color}) 14%, transparent)`}><Icon name={c.icon} size={16} /></span>
              <div class="min-w-0">
                <h3 class="card-title flex items-center">{c.title}<Info align="left" text={c.tip(p)} /></h3>
                <p id={`c-${p.key}-${c.id}-sub`} class="muted text-xs"></p>
              </div>
            </div>
            <div id={`c-${p.key}-${c.id}`} class="h-45"></div>
          </div>
        ))}
      </div>
    </section>
  ))}

  <section id="scorecard" class="card mt-4 min-w-0 scroll-mt-20 p-5" aria-label="Results against the PRD targets">
    <div class="mb-4 flex items-start gap-3">
      <span class="icon-tile"><Icon name="badge-check" size={16} /></span>
      <div class="min-w-0">
        <h2 class="card-title flex items-center">Results against the PRD targets<Info align="left" text="The targets from the requirements, and what we measured at 10M records across 100 stores. Full tables, method and the result files: docs/RESULTS.md." /></h2>
        <p class="muted text-xs">10M records · 100 stores · CPU-pinned runs</p>
      </div>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full min-w-[44rem] text-sm">
        <thead>
          <tr class="border-b hairline text-left">
            <th class="py-2.5 pr-3 font-medium">What we measure</th>
            <th class="py-2.5 pr-3 font-medium">How</th>
            <th class="py-2.5 pr-3 font-medium whitespace-nowrap">Good</th>
            <th class="py-2.5 pr-3 font-medium whitespace-nowrap">Great</th>
            <th class="py-2.5 pr-3 font-medium">Measured</th>
            <th class="py-2.5 font-medium">Verdict</th>
          </tr>
        </thead>
        <tbody>
          {scorecard.map((r) => (
            <tr class="border-b hairline align-top last:border-0">
              <td class="py-3 pr-3 font-semibold whitespace-nowrap">{r.measure}</td>
              <td class="ink-2 py-3 pr-3">{r.how}</td>
              <td class="ink-2 py-3 pr-3">{r.good}</td>
              <td class="ink-2 py-3 pr-3">{r.great}</td>
              <td class="tabnum py-3 pr-3">{r.result}</td>
              <td class="py-3">
                <span class="chip whitespace-nowrap font-semibold" style={r.met
                  ? 'background: var(--good-wash); color: var(--good-text)'
                  : 'background: color-mix(in srgb, var(--warning) 16%, transparent); color: var(--ink)'}>{r.verdict}</span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="muted mt-3 text-[11.5px]">Database safety: by design no dashboard query reaches a store database; Postgres' own transaction counters show it.</p>
  </section>

  <section id="bench" class="card mt-4 min-w-0 scroll-mt-20 p-5" aria-label="Direct database vs aggregation layer">
    <div class="mb-4 flex flex-wrap items-start gap-3">
      <span class="icon-tile"><Icon name="gauge" size={16} /></span>
      <div class="mr-auto min-w-0">
        <h2 class="card-title flex items-center">Stress test: direct primary DB vs aggregation layer<Info align="left" text="Two API instances with identical endpoints and auth under the same load. api-direct runs every dashboard query on the store's primary Postgres; api uses ClickHouse plus the version-keyed cache (also shown with the cache bypassed). A fixed checkout workload runs on the primary during every phase, so the last columns show how much dashboard traffic slows the store." /></h2>
        <p class="muted text-xs">Concurrent dashboard users hitting all four widgets for every store; latencies are p50 / p95 / p99 round trips</p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <button id="stress-run" class="btn btn-primary hidden" type="button" title="Read stress: 20 users hammer the dashboards with no pause. 4 phases of about 18 s."><Icon name="play" size={13} />Run stress test</button>
        <button id="writes-run" class="btn btn-primary hidden" type="button" title="Write storm: every store takes about 1,000 transactions/s in total while 100 dashboard viewers watch. 3 phases of about 25 s."><Icon name="play" size={13} />Run write storm</button>
      </div>
    </div>
    <div id="stress-progress" class="panel mb-4 hidden px-4 py-3"></div>
    <div id="bench-stress"><p class="muted text-sm">Loading…</p></div>
    <h3 class="mt-7 mb-3 flex items-center gap-2 text-sm font-semibold"><Icon name="flame" size={15} class="muted" />Write storm: every store writing at once<Info align="left" text="All stores taking checkouts, status changes and cancellations at a high rate while dashboard viewers watch like the real page does. The CLI version (make bench-writes) adds a first phase with the analytics pipeline paused, the pure store baseline, and reports how fast the pipeline catches up afterwards." /></h3>
    <div id="bench-writes"><p class="muted text-sm">Loading…</p></div>
  </section>

  <section class="card mt-4 min-w-0 p-5" aria-label="Single query ladder">
    <div class="mb-3 flex items-start gap-3">
      <span class="icon-tile"><Icon name="chart-column" size={16} /></span>
      <div>
        <h2 class="card-title flex items-center">Single-query ladder: tuning the primary vs ClickHouse<Info align="left" text="The same dashboard query at four optimization levels on the largest store, one at a time on an idle database: no index, the default B-tree index, covering indexes (best-case tuning of the primary), and ClickHouse. Covering indexes make every store write slower, which the stress test captures." /></h2>
        <p class="muted text-xs">What indexing the primary buys you, query by query</p>
      </div>
    </div>
    <div id="bench-ladder"><p class="muted text-sm">Loading…</p></div>
  </section>

  <section class="mt-4 grid gap-4 lg:grid-cols-3">
    <div class="card min-w-0 p-5 lg:col-span-2">
      <div class="mb-3 flex items-start gap-3">
        <span class="icon-tile"><Icon name="hourglass" size={16} /></span>
        <div>
          <h2 class="card-title flex items-center">Stores furthest behind<Info align="left" text="Data age: how old the newest store state shown on dashboards is. Apply lag: commit to queryable for the newest change. WAL retained: change log Postgres keeps until the ingester confirms it (should stay small)." /></h2>
          <p class="muted text-xs">Data age = how old the newest store state shown on dashboards is. Idle stores stay current through replication keepalives.</p>
        </div>
      </div>
      <table class="w-full text-sm tabnum">
        <thead><tr class="border-b hairline text-left">
          <th class="py-2.5 font-medium">Store</th><th class="hidden py-2.5 font-medium sm:table-cell">Size</th><th class="py-2.5 font-medium">Stream</th>
          <th class="py-2.5 text-right font-medium">Data age</th><th class="py-2.5 text-right font-medium">Apply lag</th>
          <th class="hidden py-2.5 text-right font-medium md:table-cell">WAL retained</th><th class="hidden py-2.5 text-right font-medium md:table-cell">Rows applied</th>
        </tr></thead>
        <tbody id="worst"></tbody>
      </table>
    </div>
    <div class="flex min-w-0 flex-col gap-4">
      <div class="card p-5">
        <div class="flex items-center gap-3">
          <span class="icon-tile"><Icon name="hard-drive" size={16} /></span>
          <h2 class="card-title flex items-center">ClickHouse storage<Info align="right" text="Rows and on-disk size of each analytics table. Compression = uncompressed bytes divided by bytes on disk." /></h2>
        </div>
        <table class="mt-3 w-full text-sm tabnum">
          <thead><tr class="border-b hairline text-left">
            <th class="py-2.5 font-medium">Table</th><th class="py-2.5 text-right font-medium">Rows</th><th class="py-2.5 text-right font-medium">On disk</th><th class="py-2.5 text-right font-medium">Ratio</th>
          </tr></thead>
          <tbody id="store"></tbody>
        </table>
      </div>
      <div class="card p-5">
        <div class="flex items-center gap-3">
          <span class="icon-tile"><Icon name="server" size={16} /></span>
          <h2 class="card-title flex items-center">Ingesters<Info align="right" text="Each ingester streams the change log of the stores assigned to it and writes batches to ClickHouse. Add more ingesters to scale out." /></h2>
        </div>
        <div id="ingesters" class="mt-3 space-y-2 text-xs"></div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import '../scripts/monitor';
</script>
