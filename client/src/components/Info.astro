---
// Small info icon that explains a widget on hover or keyboard focus.
import Icon from './Icon.astro';
interface Props {
  text: string;
  align?: 'center' | 'left' | 'right';
}
const { text, align = 'center' } = Astro.props;
---
<button type="button" class="info" data-tip={text} data-align={align} aria-label={text}><Icon name="info" size={14} /></button>
