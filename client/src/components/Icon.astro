---
// Inline SVG icon from the shared set in lib/icons.ts.
import { ICONS, type IconName } from '../lib/icons';
interface Props {
  name: IconName;
  size?: number;
  class?: string;
}
const { name, size = 16, class: cls = '' } = Astro.props;
---
<svg
  class:list={['icon', cls]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={ICONS[name]}
/>
